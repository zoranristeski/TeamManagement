<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportsTeamManagement.Mobile.MainPage"
             Title="Overview">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="TeamHub" FontSize="28" FontAttributes="Bold" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#68758A, Dark=#BCC6D7}" />

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Email" FontAttributes="Bold" />
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="you@example.com" />
                    <Label Text="Password" FontAttributes="Bold" />
                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Sign in" Command="{Binding SignInCommand}" HorizontalOptions="Fill" />
                        <Button Text="Sign out" Command="{Binding SignOutCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout>
                        <Label Text="Active clubs" />
                        <Label Text="{Binding ActiveClubCount}" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout>
                        <Label Text="Attendance" />
                        <Label Text="{Binding AverageAttendance, StringFormat='{0:F1}%'}" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Refresh data" Command="{Binding RefreshCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
